---
import type { Locale, Publication } from '../lib/types';

interface Props {
  items: Publication[];
  locale: Locale;
  selfAuthors?: string[];
  compact?: boolean;
}

const { items, selfAuthors = [], compact = false } = Astro.props;

const roleLabel: Record<Publication['authorRole'], string> = {
  first: 'first author',
  'co-first': 'co-first',
  corresponding: 'corresponding',
  'co-author': '',
};

// 本人姓名强调由 site.yaml 的 selfAuthors 显式登记驱动，不做模糊匹配：
// 只有去除首尾空白后与登记项大小写无关地完全一致才加粗，避免把同名他人误判为本人。
const selfAuthorKeys = new Set(
  selfAuthors.map((author) => author.trim().toLowerCase())
);

// 标题整行可点：优先解析到 DOI（出版社页面），没有 DOI 时退回 url；
// PDF / Code 仍单列在出处行，不与标题抢同一个目标。
const rows = items.map((item) => ({
  ...item,
  titleHref: item.doi ? `https://doi.org/${item.doi}` : item.url,
}));
---

{
  items.length === 0 ? (
    <p class="meta">No publications yet.</p>
  ) : (
    <ul class="pubs" class:list={[{ compact }]}>
      {rows.map((item) => (
        <li>
          <div class="year">{item.year}</div>
          <div>
            <p class="pub-title">
              {item.titleHref ? (
                <a href={item.titleHref}>{item.title}</a>
              ) : (
                item.title
              )}
            </p>
            <p class="pub-authors">
              {item.authors.map((author, index) => (
                <>
                  {index > 0 && ', '}
                  {selfAuthorKeys.has(author.trim().toLowerCase()) ? (
                    <span class="me">{author}</span>
                  ) : (
                    author
                  )}
                </>
              ))}
              {roleLabel[item.authorRole] && (
                <span class="role">{roleLabel[item.authorRole]}</span>
              )}
            </p>
            <p class="pub-venue">
              <em>{item.venue}</em>, {item.year}
              {(item.doi || item.pdf || item.code) && (
                <span class="links">
                  {item.doi && (
                    <>
                      {' · '}
                      <a
                        href={`https://doi.org/${item.doi}`}
                        aria-label={`DOI for ${item.title}`}
                      >
                        DOI
                      </a>
                    </>
                  )}
                  {item.pdf && (
                    <>
                      {' · '}
                      <a href={item.pdf} aria-label={`PDF for ${item.title}`}>
                        PDF
                      </a>
                    </>
                  )}
                  {item.code && (
                    <>
                      {' · '}
                      <a href={item.code} aria-label={`Code for ${item.title}`}>
                        Code
                      </a>
                    </>
                  )}
                </span>
              )}
            </p>
          </div>
        </li>
      ))}
    </ul>
  )
}

<style>
  /*
   * 条目版式取自可视稿 docs/design-mockups/01_页面设计_初稿.html 的首页方案 A `.pubs`：
   * 年份挂在左侧等宽栏，右侧标题 / 作者 / 出处三行；分隔线只画条与条之间。
   * 本人姓名按 site.yaml 的 selfAuthors 显式登记加粗（`.me`），不做模糊匹配。
   */
  .pubs {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .pubs > li {
    display: grid;
    grid-template-columns: 3.25rem 1fr;
    gap: 0 1rem;
    padding: 0.9rem 0;
    border-bottom: 1px solid var(--border);
  }

  .pubs > li:last-child {
    border-bottom: 0;
  }

  .compact > li {
    padding-block: 0.75rem;
  }

  .year {
    font-family: var(--font-mono);
    font-size: var(--step-1);
    color: var(--text-muted);
    padding-top: 0.2rem;
  }

  .pub-title {
    margin: 0;
    font-weight: 600;
    line-height: 1.45;
  }

  /*
   * 标题可点，但视觉上仍是「标题」而不是「链接」：沿用正文色、默认无下划线，
   * hover / 键盘聚焦时才转强调色并加下划线（与导航项同一套交互语言）。
   */
  .pub-title a {
    color: inherit;
    text-decoration: none;
  }

  .pub-title a:hover,
  .pub-title a:focus-visible {
    color: var(--accent);
    text-decoration: underline;
  }

  .pub-authors {
    margin: 0.1rem 0 0;
    font-family: var(--font-sans);
    font-size: var(--step-1);
  }

  .pub-authors .me {
    font-weight: 600;
  }

  .pub-venue {
    margin: 0.1rem 0 0;
    font-family: var(--font-sans);
    font-size: var(--step-1);
    color: var(--text-muted);
  }

  .links {
    white-space: nowrap;
  }

  .role {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    color: var(--accent);
    border: 1px solid var(--border);
    padding: 0.02rem 0.35rem;
    margin-left: 0.4rem;
    white-space: nowrap;
  }
</style>
