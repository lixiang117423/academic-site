---
import type { Locale, Publication } from '../lib/types';

interface Props {
  items: Publication[];
  locale: Locale;
  compact?: boolean;
}

const { items, compact = false } = Astro.props;

const roleLabel: Record<Publication['authorRole'], string> = {
  first: 'first author',
  'co-first': 'co-first',
  corresponding: 'corresponding',
  'co-author': '',
};
---

{items.length === 0 && <p class="meta">No publications yet.</p>}

<ul class="pubs" class:list={[{ compact }]}>
  {
    items.map((item) => (
      <li>
        <div class="year">{item.year}</div>
        <div>
          <p class="pub-title">{item.title}</p>
          <p class="pub-authors">
            {item.authors.join(', ')}
            {roleLabel[item.authorRole] && (
              <span class="role">{roleLabel[item.authorRole]}</span>
            )}
          </p>
          <p class="pub-venue">
            <em>{item.venue}</em>, {item.year}
            {(item.doi || item.pdf || item.code) && (
              <span class="links">
                {item.doi && (
                  <>
                    {' · '}
                    <a href={`https://doi.org/${item.doi}`}>DOI</a>
                  </>
                )}
                {item.pdf && (
                  <>
                    {' · '}
                    <a href={item.pdf}>PDF</a>
                  </>
                )}
                {item.code && (
                  <>
                    {' · '}
                    <a href={item.code}>Code</a>
                  </>
                )}
              </span>
            )}
          </p>
        </div>
      </li>
    ))
  }
</ul>

<style>
  /*
   * 条目版式取自可视稿 docs/design-mockups/01_页面设计_初稿.html 的首页方案 A `.pubs`：
   * 年份挂在左侧等宽栏，右侧标题 / 作者 / 出处三行；分隔线只画条与条之间。
   * 可视稿把本人姓名 `.me` 加粗，但 PublicationList 只拿到作者字符串、没有「本人」标识，
   * 取数层也不提供该字段，故不加粗某一位作者——等真实 BibTeX 导入后再评估。
   */
  .pubs {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .pubs > li {
    display: grid;
    grid-template-columns: 3.25rem 1fr;
    gap: 0 1rem;
    padding: 0.9rem 0;
    border-bottom: 1px solid var(--border);
  }

  .pubs > li:last-child {
    border-bottom: 0;
  }

  .compact > li {
    padding-block: 0.75rem;
  }

  .year {
    font-family: var(--font-mono);
    font-size: var(--step-1);
    color: var(--text-muted);
    padding-top: 0.2rem;
  }

  .pub-title {
    margin: 0;
    font-weight: 600;
    line-height: 1.45;
  }

  .pub-authors {
    margin: 0.1rem 0 0;
    font-family: var(--font-sans);
    font-size: var(--step-1);
  }

  .pub-venue {
    margin: 0.1rem 0 0;
    font-family: var(--font-sans);
    font-size: var(--step-1);
    color: var(--text-muted);
  }

  .links {
    white-space: nowrap;
  }

  .role {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    color: var(--accent);
    border: 1px solid var(--border);
    padding: 0.02rem 0.35rem;
    margin-left: 0.4rem;
    white-space: nowrap;
  }
</style>
