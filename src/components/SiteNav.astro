---
import { getSiteProfile } from '../lib/data-source';
import { pick } from '../lib/i18n';
import { href, stripBase } from '../lib/base';
import { isExternal } from '../lib/links';
import type { Locale } from '../lib/types';
import LangSwitch from './LangSwitch.astro';

interface Props {
  locale: Locale;
  currentPath: string;
}

const { locale, currentPath } = Astro.props;
const site = await getSiteProfile();

const prefix = locale === 'zh' ? '/zh' : '';
const homeHref = locale === 'zh' ? '/zh/' : '/';

// Publications 只有英文版（spec §4.1），故该条不带语言前缀
const items = [
  { href: `${prefix}/about`, label: { en: 'About', zh: '关于' } },
  { href: `${prefix}/research`, label: { en: 'Research', zh: '研究方向' } },
  { href: '/publications', label: { en: 'Publications', zh: 'Publications' } },
  { href: `${prefix}/software`, label: { en: 'Software', zh: '软件' } },
  { href: `${prefix}/cv`, label: { en: 'CV', zh: '简历' } },
];

// 命中自身与子路径都算当前页；`trailingSlash: 'ignore'` 下 `/cv` 与 `/cv/` 都要认
// （先剥掉部署前缀，比较的是站内逻辑路径）
const current = stripBase(currentPath);
const isCurrent = (path: string) =>
  current === path || current.startsWith(`${path}/`);
---

<nav class="site-nav wrap" aria-label="Primary">
  {/* 站点身份兼首页入口：可视稿是静态稿，没有第二个页面可演示，故未画这一项 */}
  <a class="site-name" href={href(homeHref)}>{pick(locale, site.name)}</a>
  <div class="nav-links">
    <ul>
      {
        items.map((item) => (
          <li>
            <a
              href={href(item.href)}
              aria-current={isCurrent(item.href) ? 'page' : undefined}
            >
              {pick(locale, item.label)}
            </a>
          </li>
        ))
      }
      <li>
        <a
          href={site.blog.url}
          target={isExternal(site.blog.url) ? '_blank' : undefined}
          rel="me noopener"
        >
          {pick(locale, site.blog.label)}
        </a>
      </li>
    </ul>
    <LangSwitch locale={locale} currentPath={currentPath} />
  </div>
</nav>

<style>
  /* 可视稿 nav.site：顶部留白 2.5rem 取自可视稿 .screen 的上内边距（正式站点无 .screen 包裹层） */
  .site-nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    padding-block: 2.5rem 1rem;
    border-bottom: 1px solid var(--border);
    font-family: var(--font-sans);
    font-size: var(--step-1);
  }

  /* 站点名：比导航项大一档、加粗，读起来是身份而不是又一个链接 */
  .site-name {
    font-size: var(--step1);
    font-weight: 600;
  }

  .nav-links {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 1rem;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 1.15rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  a {
    color: var(--text);
    text-decoration: none;
  }

  a:hover {
    color: var(--accent);
    text-decoration: underline;
  }

  a[aria-current='page'] {
    color: var(--accent);
    border-bottom: 2px solid var(--accent);
  }
</style>
