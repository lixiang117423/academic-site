---
import { getSiteProfile, listPublications } from '../lib/data-source';
import { pick } from '../lib/i18n';
import type { Locale } from '../lib/types';
import PublicationList from './PublicationList.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const site = await getSiteProfile();
const featured = await listPublications({ featured: true, limit: 5 });

// 个人信息尚未提供时，site.yaml 的字段是占位串；只在字段是真实值时渲染链接与联系方式
const hasEmail = site.email !== '' && !site.email.startsWith('TODO');
const hasLinks = site.links.length > 0;
---

<h1>{pick(locale, site.name)}</h1>
<p class="lead">
  {pick(locale, site.title)} · {pick(locale, site.affiliation)} · {site.location}
</p>

<p class="intro">{pick(locale, site.intro)}</p>

{
  (hasEmail || hasLinks) && (
    <p class="meta contact">
      {[
        ...(hasEmail
          ? [{ href: `mailto:${site.email}`, label: site.email }]
          : []),
        ...site.links.map((link) => ({ href: link.url, label: link.label })),
      ].map((item, index) => (
        <>
          {index > 0 && ' · '}
          <a href={item.href} rel="me noopener">
            {item.label}
          </a>
        </>
      ))}
    </p>
  )
}

<hr />

<h2>Selected publications</h2>
<PublicationList
  items={featured}
  locale={locale}
  selfAuthors={site.selfAuthors}
  compact
/>

<p class="meta"><a href="/publications">All publications →</a></p>

{
  site.featuredPosts.length > 0 && (
    <>
      <h2>Recent notes</h2>
      <ul class="notes">
        {site.featuredPosts.map((post) => (
          <li>
            <a href={post.url} rel="noopener">
              {post.title}
            </a>
            <span class="meta"> · {post.date}</span>
          </li>
        ))}
      </ul>
    </>
  )
}

<style>
  /*
   * 区块顺序与间距照可视稿首页方案 A：姓名开场 → 导语 → 一句话研究方向 →
   * 联系方式 → 分隔线 → 精选论文 → 「All publications →」→ 最新笔记
   * （`featuredPosts` 为空时整段不渲染，页面不留空标题）。
   */
  h1 {
    margin-block: 2.75rem 0.35rem;
  }

  /* 导语与研究方向句之间承接可视稿 `p { margin: 0 0 0.85rem }` 的节奏 */
  .intro {
    margin-bottom: 0.85rem;
  }

  .contact {
    margin-block: 0 0;
  }

  .notes {
    margin: 0;
    padding-left: 1.2rem;
  }

  .notes li {
    margin-bottom: 0.25rem;
  }
</style>
